[32m+[m
[32m+[m[32mclass Task:[m
[32m+[m[32m    """A single task with an id, a title, and a completed flag."""[m
[32m+[m
[32m+[m[32m    def __init__(self, id, title, completed=False):[m
[32m+[m[32m        self.id = id[m
[32m+[m[32m        self.title = title[m
[32m+[m[32m        self.completed = completed[m
[32m+[m
[32m+[m[32m    def __repr__(self):[m
[32m+[m[32m        return f"Task(id={self.id}, title={self.title!r}, completed={self.completed})"[m
[32m+[m
[32m+[m
[32m+[m[32m# In-memory storage[m
[32m+[m[32m_tasks = [][m
[32m+[m[32m_next_id = 1[m
[32m+[m
[32m+[m
[32m+[m[32mdef _find_task(task_id):[m
[32m+[m[32m    """Return the task with the given id, or raise ValueError if not found."""[m
[32m+[m[32m    for task in _tasks:[m
[32m+[m[32m        if task.id == task_id:[m
[32m+[m[32m            return task[m
[32m+[m[32m    raise ValueError(f"No task found with id {task_id}")[m
[32m+[m
[32m+[m
[32m+[m[32mdef add_task(title):[m
[32m+[m[32m    """Create a new task and return it. Rejects empty or whitespace-only titles."""[m
[32m+[m[32m    global _next_id[m
[32m+[m
[32m+[m[32m    if not isinstance(title, str):[m
[32m+[m[32m        raise ValueError("Task title must be a string")[m
[32m+[m
[32m+[m[32m    title = title.strip()[m
[32m+[m[32m    if not title:[m
[32m+[m[32m        raise ValueError("Task title cannot be empty")[m
[32m+[m
[32m+[m[32m    task = Task(_next_id, title)[m
[32m+[m[32m    _tasks.append(task)[m
[32m+[m[32m    _next_id += 1[m
[32m+[m[32m    return task[m
[32m+[m
[32m+[m
[32m+[m[32mdef get_tasks():[m
[32m+[m[32m    """Return a copy of the list of all tasks."""[m
[32m+[m[32m    return list(_tasks)[m
[32m+[m
[32m+[m
[32m+[m[32mdef complete_task(task_id):[m
[32m+[m[32m    """Mark a task as completed and return it."""[m
[32m+[m[32m    task = _find_task(task_id)[m
[32m+[m[32m    task.completed = True[m
[32m+[m[32m    return task[m
[32m+[m
[32m+[m
[32m+[m[32mdef delete_task(task_id):[m
[32m+[m[32m    """Remove a task from storage and return it."""[m
[32m+[m[32m    task = _find_task(task_id)[m
[32m+[m[32m    _tasks.remove(task)[m
[32m+[m[32m    return task[m
[32m+[m
[32m+[m
[32m+[m[32mdef reset_tasks():[m
[32m+[m[32m    """Clear all tasks and reset the id counter. Useful for tests."""[m
[32m+[m[32m    global _next_id[m
[32m+[m[32m    _tasks.clear()[m
[32m+[m[32m    _next_id = 1[m
